    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "multer": "^2.5.0",
    "sharp": ">=0.35.5"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
