{
  "name": "rimba-rental",
  "version": "1.1.0",
  "private": true,
  "description": "Bagus Adventure — penyewaan alat camping dengan Netlify Blobs",
  "main": "server/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "admin:init": "node --env-file-if-exists=.env server/init-admin.js",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build-netlify.cjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@codegenie/serverless-express": "^5.0.0",
