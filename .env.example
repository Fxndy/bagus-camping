# Salin menjadi .env dan isi dengan nilai acak panjang.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3000
# true hanya jika situs diakses melalui HTTPS.
COOKIE_SECURE=false
# Hop proxy terpercaya di depan aplikasi. Gunakan false bila diakses langsung.
TRUST_PROXY=1
MAX_RENTAL_DAYS=30
# Admin awal Netlify atau npm run admin:init lokal.
ADMIN_USERNAME=
ADMIN_FULL_NAME=Administrator
ADMIN_PASSWORD=

